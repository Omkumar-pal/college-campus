generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reviews           Review[]
  savedColleges     SavedCollege[]
  savedComparisons  SavedComparison[]
  comments          Comment[]

  @@map("users")
}

enum CollegeType {
  GOVERNMENT
  PRIVATE
  DEEMED
}

model College {
  id              String      @id @default(uuid())
  slug            String      @unique
  name            String
  city            String
  state           String
  country         String      @default("India")
  type            CollegeType
  establishedYear Int?        @map("established_year")
  feesMin         Int         @map("fees_min")
  feesMax         Int         @map("fees_max")
  rating          Float       @default(0)
  reviewCount     Int         @default(0) @map("review_count")
  logoUrl         String?     @map("logo_url")
  overview        String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  courses           Course[]
  placements        Placement[]
  reviews           Review[]
  savedBy           SavedCollege[]
  cutoffs           CutoffData[]
  comparisonEntries SavedComparisonCollege[]
  comments          Comment[]

  @@index([city])
  @@index([state])
  @@index([rating])
  @@index([feesMin, feesMax])
  @@index([rating, name, id])
  @@index([feesMin, feesMax, id])
  @@map("colleges")
}

model Course {
  id            String   @id @default(uuid())
  collegeId     String   @map("college_id")
  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name          String
  durationYears Int      @map("duration_years")
  feePerYear    Int      @map("fee_per_year")
  seats         Int      @default(0)
  cutoffs       CutoffData[]

  @@index([collegeId])
  @@map("courses")
}

model Placement {
  id             String   @id @default(uuid())
  collegeId      String   @map("college_id")
  college        College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  year           Int
  avgPackage     Int      @map("avg_package")
  medianPackage  Int?     @map("median_package")
  highestPackage Int?     @map("highest_package")
  topRecruiters  String[] @map("top_recruiters")

  @@index([collegeId])
  @@index([year])
  @@map("placements")
}

model Review {
  id        String   @id @default(uuid())
  collegeId String   @map("college_id")
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([collegeId])
  @@index([userId])
  @@map("reviews")
}

model SavedCollege {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId String   @map("college_id")
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, collegeId])
  @@index([userId, createdAt])
  @@map("saved_colleges")
}

model SavedComparison {
  id        String                   @id @default(uuid())
  userId    String                   @map("user_id")
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  colleges  SavedComparisonCollege[]
  createdAt DateTime                 @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@map("saved_comparisons")
}

model SavedComparisonCollege {
  comparisonId String          @map("comparison_id")
  comparison   SavedComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  collegeId    String          @map("college_id")
  college      College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@id([comparisonId, collegeId])
  @@map("saved_comparison_colleges")
}

model CutoffData {
  id         String  @id @default(uuid())
  examName   String  @map("exam_name")
  collegeId  String  @map("college_id")
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId   String  @map("course_id")
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category   String  @default("GENERAL")
  cutoffRank Int     @map("cutoff_rank")

  @@unique([examName, courseId, category])
  @@index([examName, category, cutoffRank])
  @@index([collegeId])
  @@index([courseId])
  @@map("cutoff_data")
}

model Comment {
  id        String   @id @default(uuid())
  collegeId String   @map("college_id")
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentId  String?  @map("parent_id")
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  content   String   @db.Text
  embedding Unsupported("vector(768)")?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([collegeId])
  @@index([parentId])
  @@index([userId])
  @@index([collegeId, parentId, createdAt])
  @@index([collegeId, createdAt])
  @@map("comments")
}
